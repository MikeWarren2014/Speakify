rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User settings collection - restricted to owner
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Trials collection:
    // - Authenticated users can create new trials.
    // - Get/Update allowed if it's the owner (uid match) or if it's an old doc with no uid (migration).
    // - Delete restricted to the owner.
    match /trials/{deviceId} {
      allow create: if request.auth != null;
      allow get, update: if request.auth != null &&
        (resource == null || !('uid' in resource.data) || resource.data.uid == null || resource.data.uid == request.auth.uid);
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Direct Sign Ups collection:
    // Similar to trials, but we don't allow deletion normally.
    match /directSignUps/{deviceId} {
      allow create: if request.auth != null;
      allow get, update: if request.auth != null &&
        (resource == null || !('uid' in resource.data) || resource.data.uid == null || resource.data.uid == request.auth.uid);
    }

    // App categories:
    // Anyone can read (so apps can discover categories).
    // Only authenticated users can contribute to the shared mapping.
    match /appCategories/{packageName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
